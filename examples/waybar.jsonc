// Add "custom/dayline-focus" at the start of "modules-right" and
// "custom/dayline" at its end in ~/.config/waybar/config.jsonc, then merge these
// module definitions. Replace DAYLINE as in the Hyprland example. Include waybar.css in
// your stylesheet; it uses Symbols Nerd Font for the agenda icon.
{
  "custom/dayline": {
    "format": "󰃭",
    "tooltip-format": "Toggle Dayline compact agenda",
    "on-click": "DAYLINE ui toggle-widget"
  },
  // The focus timer's countdown in minutes: a blue dot for focus, dimmed while paused
  // or ready to start, and an amber one for a break, dimmed until it starts. The tooltip
  // names the task. Right-click starts, pauses, or resumes the next step. While it runs,
  // Dayline hides its floating focus indicator.
  "custom/dayline-focus": {
    "exec": "DAYLINE waybar-focus",
    "return-type": "json",
    // Run the timer again if its process ever exits.
    "restart-interval": 5,
    "format": "{icon} {text}",
    "format-icons": {
      "running": "<span color='#359bff'>●</span>",
      "paused": "<span color='#359bff'>●</span>",
      "idle": "<span color='#359bff'>●</span>",
      "break": "<span color='#f2c27b'>●</span>",
      "break-ready": "<span color='#f2c27b'>●</span>"
    },
    "on-click": "DAYLINE ui toggle-widget",
    "on-click-right": "DAYLINE ui toggle-focus"
  }
}
